cabal-version:      3.0
name:               pan
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Eugenio
maintainer:         eugenio.manansala@outlook.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Pan.Eval
        Pan.Expr
        Pan.Parser
        Pan.Scanner
        Pan.Token
        Pan.Val
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.18.3.0,
                      containers >= 0.6.7,
                      mtl >= 2.3.1,
                      transformers >= 0.6.1.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable pan
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.3.0,
        pan

    hs-source-dirs:   app
    default-language: Haskell2010

test-suite pan-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    -- other-modules:
    build-depends:
        base ^>=4.18.3.0,
        pan,
        tasty >= 1.4,
        tasty-hunit >= 0.10,
        tasty-quickcheck >= 0.10
